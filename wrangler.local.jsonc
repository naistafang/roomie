// Local-only config used to apply drizzle migrations to the simulated D1 database.
// Matches the binding in vite.config.ts. Not used by the dev server or deploys.
{
  "name": "roomie-local",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
